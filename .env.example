DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
# razonamiento del modelo al traducir: disabled (más rápido) | low | high (más cuidadoso) | max
DEEPSEEK_THINKING=high
MAX_UPLOAD_MB=200
TRANSLATION_CONCURRENCY=10
MIN_FONT_SCALE=0.75
MIN_FONT_SIZE_PT=5.5
# true = traductor falso sin API (para probar maquetación/interfaz sin gastar tokens)
FAKE_TRANSLATOR=false
CORS_ORIGINS=http://localhost:3000
